+    /**
+     * Builds the emitter that registers generated Vaadin files with the
+     * application.
+     * <p>
+     * </p>
+     * Quarkus packages the application from the archive root. When that root is
+     * the directory the Vaadin build writes into, packaging already picks the
+     * files up and emitting them again only adds a second copy to the artifact.
+     * When the root is an archive the build tool sealed before augmentation
+     * started, emitting is the only way the files reach the application.
+     * <p>
+     * </p>
+     * The build info token file is emitted either way, because it is deleted
+     * from the build output directory once the frontend build is done.
+     */
+    private static BiConsumer<String, byte[]> createEmitter(
+            ArchiveRootBuildItem archiveRoot, Path generatedResourcesDirectory,
+            BuildProducer<GeneratedResourceBuildItem> producer) {
+        // Path.startsWith is false across FileSystems, so a mounted ZipFS root
+        // never matches - which is exactly the sealed archive case.
+        boolean packagedFromDirectory = archiveRoot.getRootDirectories().stream()
+                .anyMatch(generatedResourcesDirectory::startsWith);
+        if (!packagedFromDirectory) {
+            return (path, content) -> producer
+                    .produce(new GeneratedResourceBuildItem(path, content));
+        }
+        LOG.debug(
+                "Vaadin generated resources are packaged from {}, emitting only the build info token file.",
+                generatedResourcesDirectory);
+        return (path, content) -> {
+            if (path.endsWith("/" + FrontendUtils.TOKEN_FILE)) {
+                producer.produce(
+                        new GeneratedResourceBuildItem(path, content));
+            }
+        };
+    }
+
